# Copy to .env and fill in. Only values that are REQUIRED or that must differ
# from a default belong here — the root .env is used solely for ${VAR}
# substitution in docker-compose.yml, and nearly every var there already has a
# ${VAR:-default}. To change a tunable not listed below (poll intervals, DB
# timeouts, log level, CSP/HSTS, ports, sharding, etc.), edit its default in
# docker-compose.yml directly; setting it here only works if compose references it.

# ── Required: Postgres credentials (no compose default) ──────────────────────
POSTGRES_DB="printfarm"
POSTGRES_USER="printfarm_app"
POSTGRES_PASSWORD="replace_with_a_long_random_password"

# ── Per-service least-privilege DB roles (HP-9, §11.4) — optional, recommended ─
# By default every service connects as POSTGRES_USER (full privileges). To bound
# a compromise, provision dedicated roles and point each service at its own:
#   1) choose strong passwords (one per role);
#   2) apply the grants (idempotent):
#        psql "$SUPER_URL" \
#          -v pf_exporter_pw="$PF_EXPORTER_DB_PASSWORD" \
#          -v pf_poller_pw="$PF_POLLER_DB_PASSWORD" \
#          -v pf_slicer_pw="$PF_SLICER_DB_PASSWORD" \
#          -f db/roles/least-privilege-roles.sql
#   3) set the matching *_DATABASE_URL below.
# Start with the exporter (pure read-only, safest). Smoke-test the poller/slicer
# against their reduced role before enabling in production. Leave these unset to
# keep the current single-superuser behavior.
# EXPORTER_DATABASE_URL="postgresql://pf_exporter:replace_me@db:5432/printfarm"
# POLLER_DATABASE_URL="postgresql://pf_poller:replace_me@db:5432/printfarm"
# SLICER_DATABASE_URL="postgresql://pf_slicer:replace_me@db:5432/printfarm"

# ── Production deploy + one-click auto-update (docker-compose.deploy.yml) ─────
# IMAGE_PREFIX: Docker Hub namespace the CI workflow pushed the image under.
#   CI publishes ONE image, <IMAGE_PREFIX>/printfarm (Dockerfile.single — the
#   whole farm), tagged :latest plus an immutable :sha-<12> per commit. The old
#   per-service images (printfarm-web/-nginx/-poller/...) are no longer built;
#   the multi-container stack runs from source instead.
# UPDATE_CHECK_IMAGE: the Docker Hub repository the update card checks, e.g.
#   "youruser/printfarm". Defaults to <IMAGE_PREFIX>/printfarm, so setting
#   IMAGE_PREFIX alone is usually enough; unset+no prefix hides the card.
#   The card compares the running image's baked commit against what is PUBLISHED
#   (the `latest` tag's digest, resolved back to its immutable sha-<12> tag) —
#   not against the newest GitHub commit — so it never offers an update that CI
#   has not finished building.
# UPDATE_CHECK_TAG: the moving tag a host pulls (default "latest").
# UPDATE_CHECK_TOKEN: optional bearer token for a private Docker Hub repository
#   or a higher rate limit; anonymous works for public ones.
# UPDATE_CHECK_REPO: "owner/repo" — now used only by the ROLLBACK button, to
#   dispatch .github/workflows/rollback.yml.
# WATCHTOWER_TOKEN: LEAVE EMPTY. Deploys are manual — docker-compose.deploy.yml
#   ships no updater sidecar, so nothing on the host applies an update by itself.
#   This variable is what shows the in-app "Update now" / "Roll back" buttons
#   (empty = hidden, endpoints 503); setting it with no sidecar running gives you
#   buttons that fail when clicked. The "update available" CHECK works either way.
#   Update with:
#     docker compose -f docker-compose.yml -f docker-compose.deploy.yml pull
#     docker compose -f docker-compose.yml -f docker-compose.deploy.yml up -d
# UPDATE_ROLLBACK_TOKEN: enables the admin "Roll back" button — which also needs
#   WATCHTOWER_TOKEN, so on a manual-deploy host it stays hidden and you run
#   .github/workflows/rollback.yml from the Actions tab instead, then pull + up -d.
#   A rollback means re-pointing `:latest` in the registry (Watchtower, where used,
#   can only ever re-pull the SAME tag); that is what the workflow does, and this
#   token lets the web server dispatch it. Use a FINE-GRAINED GitHub PAT scoped to just this
#   repository with `Actions: read and write` and no other permission. Do NOT use
#   a Docker Hub write token here: a registry-write credential inside the web
#   container would let anyone who compromised it push arbitrary images that
#   Watchtower then deploys as root. Empty = rollback hidden (history still works).
# UPDATE_RUN_DEADLINE_MS / UPDATE_HEALTH_PASSES: how long an update run may take
#   before it is marked timed_out, and how many consecutive /readyz passes the new
#   version must post before the run is called a success.
IMAGE_PREFIX="yourdockerhubuser"
UPDATE_CHECK_REPO=""
# UPDATE_CHECK_IMAGE=""
# UPDATE_CHECK_TAG="latest"
WATCHTOWER_TOKEN=""
UPDATE_ROLLBACK_TOKEN=""
# UPDATE_ROLLBACK_WORKFLOW="rollback.yml"
# UPDATE_RUN_DEADLINE_MS="900000"
# UPDATE_HEALTH_PASSES="3"
# On a dedicated deploy host (not a dev clone), uncomment this so plain
# `docker compose up`/`down`/`pull` always include docker-compose.deploy.yml —
# no more remembering `-f docker-compose.yml -f docker-compose.deploy.yml` (and
# no more `docker compose down` leaving watchtower running because it forgot
# about the override file). Compose reads COMPOSE_FILE straight out of .env.
# COMPOSE_FILE="docker-compose.yml:docker-compose.deploy.yml"

# ── Optional overrides (uncomment only to change from the default) ────────────
# Encrypt printer connection secrets at rest (AES-256-GCM). Must be identical on
# web, slicer-proxy AND poller. Empty = plaintext. Generate as above.
# PRINTER_SECRET_KEY=""
# H-2 Bambu TLS. Bambu printers use self-signed certs, so verification is skipped
# by default (BAMBU_TLS_SKIP_VERIFY=true). Close the resulting LAN MITM window by
# PINNING each printer's cert fingerprint (no CA needed). The poller logs each
# observed fingerprint — grep the poller logs for "H-2: bambu serial" — then set
# BAMBU_CERT_PINS to enforce. Empty = observe-only (no change). Per-printer:
# BAMBU_CERT_PINS="00M09A123456789=sha256:<hex>,00M09B...=sha256:<hex>"
# Serve the session cookie as Secure once the site is behind HTTPS.
# SESSION_COOKIE_SECURE="true"
# Force a fixed public origin (OAuth redirects, slicer Device redirect).
# APP_BASE_URL="https://printfarm.example.com"
# Sign the slicer operator-grant token (shared web ⇄ slicer-proxy); empty = off.
# SLICER_GRANT_SECRET=""
# Auto-map slicer pushes onto the printer's AMS trays (material match, color
# preferred, fullest spool). "false" = always use the external spool instead.
# SLICER_AMS_AUTO="true"
# Redis cache/shared-counter in front of Postgres (optional; degrades gracefully).
# REDIS_URL="redis://redis:6379"
# L-1: require a Redis password so a co-located compromised container cannot
# read/flush rate-limit keys or sessions. When set, include it in REDIS_URL, e.g.
# REDIS_PASSWORD="replace_with_a_long_random_password"
REDIS_URL="redis://:replace_with_a_long_random_password@redis:6379"
# Leave REDIS_PASSWORD empty for a LAN-only deploy where the network is the boundary.
REDIS_PASSWORD="replace_with_a_long_random_password"
# Public-intake rate limit (queue submit / manager request): max requests per IP
# per window, and the window length in seconds. Defaults: 60 per 3600s. The
# default is generous because a whole class often submits from ONE public IP
# behind institutional NAT — a low cap would 429 legitimate print requests.
# Raise it further for large shared-NAT deployments; lower it to tighten abuse.
# PUBLIC_INTAKE_MAX_PER_WINDOW="60"
# PUBLIC_INTAKE_WINDOW_SECONDS="3600"
# Public viewer mode: redact printer connection details, disable controls.
# VITE_PUBLIC_VIEWER_MODE="true"
# DDoS / abuse mitigation at the nginx edge (L7): per-client-IP request rate,
# burst allowance, and max concurrent connections. Defaults are generous so a
# shared-NAT classroom isn't throttled; a real flood is still capped, and
# rejections return 429. A volumetric (L3/L4) DDoS needs an upstream CDN/scrubber
# in front of nginx — this protects the app tier, not the network pipe.
# RATE_LIMIT_REQ_RATE="50r/s"   # nginx units: r/s or r/m
# RATE_LIMIT_REQ_BURST="100"
# RATE_LIMIT_CONN="100"
# Prometheus is reachable at /prometheus on the public site for an external
# Grafana, but has no auth of its own (H-1) and its UI / /federate / query API
# leak the whole farm's internal metrics. Posture is FAIL-CLOSED: with neither
# var below set, /prometheus returns 403. Set PROMETHEUS_BASIC_AUTH_PASSWORD to
# expose it behind HTTP Basic Auth, or PROMETHEUS_ALLOW_ANONYMOUS=true to serve
# it with no auth on a trusted LAN. An internal-network Grafana never needs
# either — it reaches http://prometheus:9090/prometheus directly.
# PROMETHEUS_BASIC_AUTH_USER="admin"
# PROMETHEUS_BASIC_AUTH_PASSWORD=""
# PROMETHEUS_ALLOW_ANONYMOUS="false"
# ESP32 status-light MQTT broker (per-printer RGB status lights). wss-only: the
# web service embeds an MQTT broker reachable at /mqtt over MQTT-over-WebSockets
# on the normal HTTPS port through nginx — there is no raw-TCP listener and no
# extra host port to publish. Devices subscribe to their printer's retained
# status topic and authenticate with a shared credential auto-generated into
# app_settings on first start (shown on the printer page's flash dialog). The
# status string carries no secrets, but the wss connection itself still needs a
# certificate the device's public-CA bundle trusts (Let's Encrypt-style — a
# self-signed cert will not validate; see firmware/status-light/README.md). Set
# STATUS_LIGHT_ENABLED=false (or the legacy STATUS_LIGHT_MQTT_ENABLED=false) to
# turn the broker off entirely. STATUS_LIGHT_PUBLISH_INTERVAL_MS is how often
# the web tier re-reads printer status and publishes any change (default 4000);
# STATUS_LIGHT_STALE_MS is how long since a device last reported before the
# dashboard shows it disconnected.
# STATUS_LIGHT_ENABLED="true"
# STATUS_LIGHT_MQTT_ENABLED="true"
# STATUS_LIGHT_PUBLISH_INTERVAL_MS="4000"
# STATUS_LIGHT_STALE_MS="15000"
# ── MCP server (LLM control surface over /api/v1) ────────────────────────────
# An 8th service exposing the farm's /api/v1 API as Model Context Protocol tools
# for an LLM client. Over HTTP (behind nginx at /mcp) the caller supplies their
# own printfarm_manage API key per request, so nothing extra is needed here. The
# vars below only matter if you change the defaults or run it over stdio.
#
# The public /mcp route is FAIL-CLOSED (403) by default — the MCP server is a
# full farm-control surface meant for the internal network. Set MCP_HTTP_PUBLIC=
# true to reach it from the public site (still guarded by a printfarm_manage key).
# MCP_HTTP_PUBLIC="false"
# MCP_TRANSPORT="http"            # "stdio" for a local desktop client
# MCP_PORT="8092"
# PRINTFARM_API_BASE="http://web:5173"
# Only for MCP_TRANSPORT=stdio: the single printfarm_manage key the local server
# uses for every call (mint it in Settings → API Keys).
# PRINTFARM_API_KEY=""
# AI-agent least privilege. "restricted" (default) blocks the admin escape-hatch
# from WRITING to privilege-escalation surfaces (slicer-keys, users,
# admin-credential, manager-requests, settings) so a prompt-injected agent can't
# mint keys, reset the admin password, or create backdoor accounts; reads still
# work. Set "full" to allow those writes. Strongest: also give the agent a
# printfarm_read/printfarm_control key rather than printfarm_manage.
# MCP_ADMIN_MODE="restricted"
# ── Backup & Restore (Settings → System) ─────────────────────────────────────
# Backups stream: the download is written into the response entry by entry, and
# a restore upload is spooled to a temp file and read back one entry at a time,
# so neither is bounded by container memory. The two caps below must agree —
# BACKUP_MAX_BODY_SIZE is nginx's body cap for the restore upload, so it has to
# be >= BACKUP_UPLOAD_MAX_BYTES (2 GB / 2048m by default).
# BACKUP_UPLOAD_MAX_BYTES="2147483648"
# BACKUP_MAX_BODY_SIZE="2048m"
# Where the restore upload is spooled before being read. Defaults to the OS temp
# dir; point it at a mounted volume if the container's /tmp is small.
# BACKUP_TMP_DIR=""

# ── Single-container deployment (docker-compose.single.yml) ──────────────────
# The all-in-one image (Dockerfile.single) runs PostgreSQL, the Node web server,
# the slicer proxy, the MCP server, the Go poller and the Go exporter in ONE
# container, and drops nginx / Redis / Prometheus. These knobs only apply there;
# the multi-container stack ignores them.
#
# Mount the slicer proxy on /printers/ and the MCP server on /mcp inside the web
# process instead of running them as separate containers behind nginx.
# EMBED_SLICER_PROXY="true"
# EMBED_MCP="true"
# nginx used to return 404 for /metrics on the public site. With no nginx, the
# web tier's own metrics move to their own listener on this port instead.
# METRICS_LISTEN_PORT="9181"
# METRICS_LISTEN_HOST="0.0.0.0"
# Host port the Go exporter's printfarm_* metrics are published on (loopback).
# WEB_METRICS_PORT="9181"
# Whether X-Real-IP / X-Forwarded-For may be trusted for audit-log IPs and login
# rate limiting. True by default (the split stack always has nginx overwriting
# them). Set false when nothing trusted sits in front — otherwise a client can
# forge its own IP and mint a fresh rate-limit bucket per request.
# TRUST_PROXY_HEADERS="true"
# Use an external database instead of the in-container one (set DATABASE_URL too).
# EMBEDDED_POSTGRES="true"
# Skip the poller / exporter child processes in the all-in-one container.
# RUN_POLLER="true"
# RUN_EXPORTER="true"
